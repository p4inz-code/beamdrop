{
  "name": "beamdrop",
  "version": "1.2.0",
  "description": "Zero-cloud, FDM-minimal local Wi-Fi file & 2GB+ video transfer app for PC and mobile.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node src/cli.js",
    "test": "node --test tests/server.test.js",
    "dist:dir": "electron-builder --dir",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.p4inzcode.beamdrop",
    "productName": "BeamDrop",
    "copyright": "Copyright (C) 2026 Atharva Patil (p4inz-code)",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "NOTICE"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/p4inz-code/beamdrop.git"
  },
  "homepage": "https://github.com/p4inz-code/beamdrop#readme",
  "bugs": {
    "url": "https://github.com/p4inz-code/beamdrop/issues"
  },
  "author": "Atharva Patil <p4inz-code> (https://github.com/p4inz-code)",
  "keywords": [
    "file-sharing",
    "lan",
    "wifi-transfer",
    "video-streaming",
    "electron",
    "pwa"
  ],
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "archiver": "^7.0.1",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.18.0"
  }
}
